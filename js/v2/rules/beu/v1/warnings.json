{
  "id": "beu-v1-warnings",
  "priority": 100,
  "rules": [
    {
      "id": "beu-warning-missing-departure-time",
      "priority": 100,
      "target": "activities",
      "match": { "field": "departureTime.value", "operator": "exact", "value": null },
      "action": { "type": "warning", "message": "Fehlende Abfahrtszeit" }
    },
    {
      "id": "beu-warning-missing-arrival-time",
      "priority": 99,
      "target": "activities",
      "match": { "field": "arrivalTime.value", "operator": "exact", "value": null },
      "action": { "type": "warning", "message": "Fehlende Ankunftszeit" }
    },
    {
      "id": "beu-warning-unknown-activity",
      "priority": 98,
      "target": "activities",
      "match": { "field": "activityType", "operator": "exact", "value": "unknown" },
      "action": { "type": "warning", "message": "Unbekannte Tätigkeit" }
    },
    {
      "id": "beu-warning-conflicting-information",
      "priority": 97,
      "target": "activities",
      "match": { "field": "rawActivity", "operator": "regex", "value": "^(?=.*Vorbereitung)(?=.*Nachbereitung).*$", "ignoreCase": true },
      "action": { "type": "warning", "message": "Widersprüchliche Tätigkeitsangabe" }
    }
  ]
}
